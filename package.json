{
  "name": "schablonen-maker",
  "productName": "Schablonen Maker",
  "private": true,
  "version": "1.0.0",
  "description": "Windows-App: Fotos in mehrstufige Banksy-Schablonen verwandeln (mehrlagige Sprühschablonen, SVG/PDF/DXF)",
  "author": "Schablonen Maker",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsx scripts/verify.ts",
    "icons": "tsx scripts/make-icons.ts",
    "typecheck": "tsc -b --noEmit false --dry 2>/dev/null || tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "de.schablonenmaker.app",
    "productName": "Schablonen Maker",
    "copyright": "Schablonen Maker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SchablonenMaker-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Schablonen Maker",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1053"
    },
    "portable": {
      "artifactName": "SchablonenMaker-${version}-portable.${ext}"
    }
  }
}
